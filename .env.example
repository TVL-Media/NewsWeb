# Most of these can be changed later in Admin → Settings (saved values there win over this file).
# Keys and passwords are best entered in the admin panel, where they are stored encrypted.
APP_NAME=NextGenNews
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nextgennews
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Production: redis for cache + queues (Horizon). Locally without Redis use "database".
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 media (MEDIA_DISK=s3). AWS_URL = CloudFront URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI summaries. Empty key = AiWriter returns seeded sample drafts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Text-to-speech: fake (silent test audio, development only) | google | azure
TTS_DRIVER=fake
GOOGLE_TTS_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Audio on the website (Listen buttons, Morning 5 player). Off = hidden; the Top 5 card shows trending stories.
AUDIO_ENABLED=false

# Reels (short vertical videos). FFMPEG_PATH = full path to the ffmpeg binary (ffprobe must sit next to it).
#   Windows (winget):  C:/Users/<you>/AppData/Local/Microsoft/WinGet/Links/ffmpeg.exe
#   Windows (Laragon): C:/laragon/bin/ffmpeg/bin/ffmpeg.exe
#   Linux:             /usr/bin/ffmpeg
REELS_ENABLED=true
# Make a reel automatically from every published story (off = reels only from admin uploads)
REELS_AUTO_FROM_STORIES=false
FFMPEG_PATH=ffmpeg
REEL_MAX_SECONDS=60
# Largest admin upload in MB (PHP upload_max_filesize / post_max_size must allow it)
REEL_UPLOAD_MAX_MB=200

# OTP SMS: log | msg91
SMS_DRIVER=log
# Development only: every OTP is this 6-digit code (ignored when APP_ENV=production)
OTP_DEV_CODE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Analytics + errors (skipped when empty). FIREBASE_WEB_CONFIG = the web app config as one line of JSON.
GA4_ID=
FIREBASE_WEB_CONFIG=
SENTRY_LARAVEL_DSN=

# Feature switches (starting values; Admin → Settings → Features takes over once saved)
FEATURE_AI_AUTOPUBLISH=true
FEATURE_MORNING5=true
FEATURE_QUIZ=true
FEATURE_POLLS=true
FEATURE_COMMENTS=true
FEATURE_OTP_LOGIN=true

VITE_APP_NAME="${APP_NAME}"